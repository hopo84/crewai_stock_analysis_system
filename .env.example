# 模型提供商选择（openai 或 deepseek）
MODEL_PROVIDER=openai

# OpenAI API配置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MANAGER_MODEL=gpt-4o-mini
OPENAI_PLANNING_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# DeepSeek API配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_CODER_MODEL=deepseek-chat
DEEPSEEK_MANAGER_MODEL=deepseek-chat
DEEPSEEK_PLANNING_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TOP_P=0.95

# Serper API配置（用于网络搜索）
SERPER_API_KEY=your-serper-api-key-here

# 系统配置
DEBUG=True
LOG_LEVEL=INFO

# 缓存配置
CACHE_ENABLED=True
CACHE_TTL=3600

# 监控配置
MONITORING_ENABLED=True
MONITORING_INTERVAL=300

# Web界面配置
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_DEBUG=True

# 数据库配置（可选）
DATABASE_URL=sqlite:///stock_analysis.db

# 邮件通知配置（可选）
EMAIL_ENABLED=False
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_EMAIL=your-email@gmail.com
EMAIL_TO_EMAILS=recipient1@gmail.com,recipient2@gmail.com